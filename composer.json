{
    "name": "magenable/module-admin-notification-feed",
    "description": "Magenable feed for admin notification",
    "require": {
        "magento/framework": ">=102.0",
        "ext-simplexml": "*",
        "ext-curl": "*"
    },
    "type": "magento2-module",
    "version": "1.0.3",
    "license": "proprietary",
    "authors": [
        {
            "name": "Magenable",
            "email": "support@magenable.com.au",
            "homepage": "https://magenable.com.au",
            "role": "Technical Support"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magenable\\AdminNotificationFeed\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
